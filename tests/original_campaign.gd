	scene.refresh()
	scene.show_battle_details()
	check(int(scene.state.battle.tactics.selected)==1 and not scene.deployment_confirm.visible and not scene.tactical_start.visible,"reopened tactical window preserves selection and stage")
	check(scene.end_button.disabled and scene.tactical_end.visible,"tactical handover uses its own control without skipping the strategic battle")
	scene.battle_details.hide()
	DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
	# Fresh valid expedition: deploy closer before starting the first tactical turn.
	var attack_raw=FileAccess.get_file_as_bytes("res://reference/fixtures/expedition-2-before.bin")
	var attack_file=FileAccess.open(path,FileAccess.WRITE)
	attack_file.store_string(JSON.stringify({"format":"native-original-v1","rom_crc32":2966394227,"sram":Array(attack_raw),"frame_counter":0,"random_cursor":0,"pending_development":null,"pending_search":null}))
