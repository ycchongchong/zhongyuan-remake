	check(scene.native.load_session(path).is_empty() and not scene.native.dispatch_expedition(13,12,[143,144,145],143).has("error"),"attack UI starts from valid original expedition")
	check(scene.native.prepare_deployment().is_empty(),"attack UI prepares original battlefield")
	for step in range(2):scene.native.move_deployment(2)
	for step in range(16):
		if not scene.native.move_deployment(1).is_empty():break
	for unit in range(3):scene.native.confirm_deployment()
