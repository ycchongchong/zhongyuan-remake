	check(int(scene.state.battle.tactics.selected)==1 and int(scene.state.battle.tactics.points)==points_before,"selecting another attacker preserves shared mobility")
	scene.deployment_arrows[0].emit_signal("pressed")
	check(int(scene.state.sram[0xdc6])==0x2e and int(scene.state.battle.tactics.points)<points_before,"second attacker uses same mobility budget")
	var tactical_sram:Array=scene.state.sram.duplicate()
	check(scene.native.save_session(path).is_empty() and scene.native.load_session(path).is_empty() and scene.native.session_snapshot().sram==tactical_sram,"tactical movement and selected officer replay on load")
